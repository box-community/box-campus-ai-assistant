# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Your enterprise ID (account icon > Copy Enterprise ID)
BOX_ENTERPRISE_ID=your_enterprise_id

# Box login email of the person who co-owns and manages the hubs
HUB_ADMIN_LOGIN=hub.admin@example.edu

# Box login email of a non-admin user in your enterprise. seed.py adds them to the students group for testing
TEST_STUDENT_LOGIN=student@example.edu

# ID of the Box group whose members can use the portal chat. seed.py writes it for you
STUDENTS_GROUP_ID=

# Your Box domain. Use your custom domain, such as yourcompany.app.box.com, if you have one
BOX_EMBED_DOMAIN=app.box.com

# Box-hosted chat button script. To check for a newer version, see any hub > Embed > Hub AI Chat > Chat button
BOX_CHAT_BUTTON_SCRIPT=https://cdn01.boxcdn.net/embeddable-ai-chat-script/2.8.0/box_integrations_ai_chat_button.js

# Portal port. Avoid 5000 on macOS, where AirPlay Receiver uses it
PORT=3000
